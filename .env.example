# Base de datos Postgres en Neon (neon.com).
# En tu proyecto de Neon: botón "Connect", copia la dirección (empieza con postgresql://
# y termina en ?sslmode=require). Usa la versión "pooled" (dice -pooler en la dirección).
DATABASE_URL=
# Solo para npm run db:ejemplos, después de confirmar en Neon que DATABASE_URL apunta a desarrollo.
DATABASE_BRANCH=

# Autenticación: genera un texto largo y aleatorio (por ejemplo: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# En producción: la dirección pública con https:// (activa cookies seguras).
BETTER_AUTH_URL=http://localhost:3000

# OpenRouter: llave y modelo con soporte de imágenes/PDF y structured outputs
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Archivos de cotización: local (desarrollo), blob (Vercel Blob privado), s3 (AWS/R2) o uploadthing.
# Dentro de Vercel, si se deja vacío, se usa blob.
ARCHIVOS_STORAGE=local
# Vercel Blob: en Vercel no hace falta (se conecta solo). Para probar blob en tu
# computadora, copia el token del almacenamiento (Storage → tu Blob → .env.local).
BLOB_READ_WRITE_TOKEN=
# UploadThing: crea una app en https://uploadthing.com/dashboard y copia su token.
UPLOADTHING_TOKEN=
# AWS S3 / Cloudflare R2
# Para AWS deja S3_ENDPOINT vacío y usa una región como us-east-1.
# Para R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com y S3_REGION=auto.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Primer administrador (lo crea `npm run db:seed`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
